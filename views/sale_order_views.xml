<odoo>
    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Inserta el botón en una ubicación válida dentro de la vista -->
            <xpath expr="//header" position="inside">
                <button name="generar_presupuesto_pdf" type="object" string="Generar Presupuesto PDF"/>
            </xpath>

            <!-- Ocultar el campo original de plazo de pago -->
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Agregar el campo "Forma de pago" después del campo "Plazos de pago" -->
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="payment_method" placeholder="Especificar forma de pago" />
            </xpath>

            <!-- Agregar campos editables después del campo "partner_id" en orden correcto -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_desarrollo_web" invisible="1"/>
                <field name="is_actualizacion_web" invisible="1"/>
                <field name="is_desarrollo_web_especial" invisible="1"/>
                <field name="is_hosting" invisible="1"/>
                <field name="is_landing_page" invisible="1"/>
                <field name="text_pagina1" placeholder="Rellenar texto página 1" widget="char_length_counter" attrs="{'required': [('is_desarrollo_web', '=', False)], 'invisible': [('is_desarrollo_web', '=', True)]}"/>
                <field name="text_pagina1_web" placeholder="Ej: Incluye login de usuarios y roles. Integraciones con APIs externas y redes sociales. Tiempo de respuesta cliente: max 48hs." widget="char_length_counter" attrs="{'required': [('is_desarrollo_web', '=', True)], 'invisible': [('is_desarrollo_web', '=', False)]}"/>
                <field name="text_pagina2_web" placeholder="Ej: Hasta 5 páginas/módulos. Incluye diseño a medida (2 propuestas, 3 revisiones). Responsive design (mobile, tablet, desktop)." widget="char_length_counter" attrs="{'invisible': ['|', '|', '|', ('is_desarrollo_web', '=', False), ('is_hosting', '=', True), ('is_landing_page', '=', True), ('is_actualizacion_web', '=', True)]}"/>
                <field name="cantidad_minima" placeholder="Ej: 6 meses" help="Mínimo de meses que tiene que ser contratado el servicio" attrs="{'invisible': [('is_hosting', '=', False)]}"/>
                <field name="text_pagina2" placeholder="Ej: Hasta 5 páginas/módulos. Incluye diseño a medida (2 propuestas, 3 revisiones). Responsive design (mobile, tablet, desktop)." widget="char_length_counter" required="1"/>
                <field name="incluye_multilenguaje" widget="boolean_toggle" attrs="{'invisible': [('is_desarrollo_web_especial', '=', False)]}"/>
                <field name="idiomas" placeholder="Ej: Inglés y Español" attrs="{'invisible': ['|', ('is_desarrollo_web_especial', '=', False), ('incluye_multilenguaje', '=', False)]}"/>
                <field name="incluye_tienda" widget="boolean_toggle" attrs="{'invisible': [('is_desarrollo_web_especial', '=', False)]}"/>
                <field name="incluye_portal" widget="boolean_toggle" attrs="{'invisible': [('is_desarrollo_web_especial', '=', False)]}"/>
            </xpath>

            <!-- Insertar el nuevo campo en el mismo lugar -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="plazo_ejecucion"/>
                <field name="valor_cuota1" attrs="{'invisible': ['|', ('is_desarrollo_web', '=', False), ('is_hosting', '=', True)]}"/>
                <field name="cantidad_cuotas2" attrs="{'invisible': ['|', ('is_desarrollo_web', '=', False), ('is_hosting', '=', True)]}"/>
                <field name="valor_cuota2" attrs="{'invisible': ['|', ('is_desarrollo_web', '=', False), ('is_hosting', '=', True)]}"/>
                <field name="cantidad_cuotas3" attrs="{'invisible': ['|', ('is_desarrollo_web', '=', False), ('is_hosting', '=', True)]}"/>
                <field name="valor_cuota3" attrs="{'invisible': ['|', ('is_desarrollo_web', '=', False), ('is_hosting', '=', True)]}"/>
                <field name="paginas" attrs="{'invisible': [('is_actualizacion_web', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
